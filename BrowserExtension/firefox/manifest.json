{
  "manifest_version": 2,
  "name": "SekoDL Bridge",
  "version": "1.0.0",
  "description": "Send direct download links to SekoDL through native messaging.",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "applications": {
    "gecko": {
      "id": "sekodl-bridge@example.local"
    }
  }
}
